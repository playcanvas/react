{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "packageRules": [
    {
      "matchManagers": ["npm"],
      "groupName": "all npm dependencies",
      "schedule": ["on monday at 10:00am"],
      "minimumReleaseAge": "1 day"
    },
    {
      "matchDepTypes": ["devDependencies"],
      "rangeStrategy": "pin"
    },
    {
      "matchDepTypes": ["dependencies"],
      "rangeStrategy": "widen"
    },
    {
      "description": "pnpm-workspace.yaml exempts playcanvas from pnpm's minimumReleaseAge, so engine updates can land as soon as they are released",
      "matchPackageNames": ["playcanvas"],
      "groupName": "playcanvas",
      "prCreation": "immediate",
      "minimumReleaseAge": "0",
      "labels": ["playcanvas", "dependencies"],
      "assignees": ["marklundin"],
      "semanticCommitType": "feat",
      "semanticCommitScope": "playcanvas"
    },
    {
      "description": "typescript-eslint doesn't support TypeScript 7 yet (its peer range is <6.1.0); hold the major until it does",
      "matchManagers": ["npm"],
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    },
    {
      "description": "eslint-plugin-react and eslint-plugin-jsx-a11y (via @playcanvas/eslint-config) and eslint-plugin-import have no ESLint 10 releases yet; hold the major until they do or are replaced",
      "matchManagers": ["npm"],
      "matchPackageNames": ["eslint"],
      "allowedVersions": "<10"
    }
  ]
}
