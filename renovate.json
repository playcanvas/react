{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "packageRules": [
    {
      "matchManagers": ["npm"],
      "groupName": "all npm dependencies",
      "schedule": ["on monday at 10:00am"]
    },
    {
      "matchDepTypes": ["devDependencies"],
      "rangeStrategy": "pin"
    },
    {
      "matchDepTypes": ["dependencies"],
      "rangeStrategy": "widen"
    },
    {
      "matchPackageNames": ["playcanvas"],
      "groupName": "playcanvas",
      "prCreation": "immediate",
      "minimumReleaseAge": "0",
      "labels": ["playcanvas", "dependencies"],
      "assignees": ["marklundin"],
      "semanticCommitType": "feat",
      "semanticCommitScope": "playcanvas"
    },
    {
      "description": "changesets/action v2 requires Changesets CLI v3; hold the major until the CLI and workflow inputs are migrated",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["changesets/action"],
      "allowedVersions": "<2"
    }
  ]
}
